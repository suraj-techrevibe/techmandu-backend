{
  "name": "techrevibe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node-dev ./src/index.ts",
    "dev:worker": "ts-node ./src/index-worker.ts",
    "prod": "node dist/src/index-worker.js & node dist/src/index.js",
    "dev": "concurrently yarn:dev:*",
    "build": "./build.sh",
    "build:ui": "rm -rf src/custom-admin-ui/admin-ui && ts-node src/custom-admin-ui/compile-admin-ui.ts",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start": "concurrently yarn:start:*",
    "migration:generate": "ts-node migration generate",
    "migration:run": "ts-node migration run",
    "migration:revert": "ts-node migration revert",
    "codegen": "graphql-codegen --config codegen.json",
    "prepare": "husky",
    "test": "node --require ts-node/register/transpile-only --test \"src/**/*.test.ts\"",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/lib-storage": "^3.864.0",
    "@elastic/elasticsearch": "^9.3.1",
    "@nestjs/schedule": "^6.0.0",
    "@pinelab/vendure-plugin-admin-ui-helpers": "^1.4.0",
    "@pinelab/vendure-plugin-campaign-tracker": "^0.1.0",
    "@pinelab/vendure-plugin-facet-suggestions": "^1.3.0",
    "@pinelab/vendure-plugin-limited-products": "^3.2.0",
    "@pinelab/vendure-plugin-modify-customer-orders": "^1.6.0",
    "@pinelab/vendure-plugin-order-export": "^1.5.0",
    "@pinelab/vendure-plugin-popularity-scores": "^1.9.0",
    "@pinelab/vendure-plugin-primary-collection": "^2.2.0",
    "@pinelab/vendure-plugin-stock-monitoring": "^2.0.2",
    "@vendure/admin-ui-plugin": "3.3.2",
    "@vendure/asset-server-plugin": "3.3.2",
    "@vendure/core": "3.3.2",
    "@vendure/elasticsearch-plugin": "3.5.3",
    "@vendure/email-plugin": "3.3.2",
    "@vendure/graphiql-plugin": "3.3.2",
    "@vendure/payments-plugin": "^3.5.1",
    "adm-zip": "^0.5.16",
    "aws-sdk": "^2.1494.0",
    "axios": "1.13.5",
    "crypto-js": "^4.2.0",
    "dotenv": "16.5.0",
    "google-auth-library": "^10.5.0",
    "jsbarcode": "^3.12.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "3",
    "pg": "8.16.0",
    "puppeteer": "^24.17.1",
    "sharp": "^0.32.6",
    "stripe": "^19.1.0",
    "tmp": "^0.2.5",
    "ts-node-dev": "^2.0.0",
    "tsc": "^2.0.4",
    "uuid": "^11.1.0",
    "xero-node": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@types/adm-zip": "^0.5.7",
    "@types/crypto-js": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/react": "19.1.8",
    "@types/tmp": "^0.2.6",
    "@types/uuid": "^10.0.0",
    "@vendure/cli": "3.3.2",
    "@vendure/ui-devkit": "^3.3.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.8.2"
  }
}

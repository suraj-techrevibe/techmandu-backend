{{> header title="Verify Your New Email Address" }}

<mj-section padding-bottom="20px">
  <mj-text align="center" font-size="24px" font-weight="bold" color="#000000" line-height="1.5" padding="0">
    <strong>Confirm Your Email Change</strong>
  </mj-text>
</mj-section>

<mj-divider border-color="#e8e6f6" border-width="1px" padding="20px 0" />

<mj-section padding-bottom="16px">
  <mj-text font-size="20px" color="#000000" line-height="1.5" padding="0">
    We received a request to change the email address on your Techmandu. account to this address.
    To continue, please verify this change by clicking the button below.
    If you didn’t request this, you can safely ignore this email.
  </mj-text>
</mj-section>

<mj-section padding-bottom="20px">
  <mj-column>
    <mj-button
      font-family="Helvetica"
      font-size="16px"
      background-color="#F15A27"
      color="white"
      border-radius="10px"
      width="100%"
      height="50px"
      padding="16px 0"
      href="{{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}"
      aria-label="Verify your new email address">
      Verify Email Address
    </mj-button>
  </mj-column>
</mj-section>

<mj-section padding-bottom="8px">
  <mj-text font-size="12px" color="#8c8c8c" line-height="1.6" padding="0">
    Having trouble with the button? Copy and paste this URL into your browser:<br/>
    {{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}
  </mj-text>
</mj-section>

{{> footer }}

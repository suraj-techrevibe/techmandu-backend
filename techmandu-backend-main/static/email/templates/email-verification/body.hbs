{{> header title="Verify Your Email Address" }}
<mj-body background-color="#ffffff">

  <mj-section padding-bottom="20px">
    <mj-text align="center" font-size="24px" font-weight="bold" color="#000000" line-height="1.5" padding="0">
      <strong>Verify Your Email Address</strong>
    </mj-text>
  </mj-section>

  <mj-divider border-color="#e8e6f6" border-width="1px" padding="20px 0" />

  <mj-section padding-bottom="20px">
    <mj-text font-size="20px" color="#000000" line-height="1.5" padding="0">
      <strong>Hey, {{ user.firstName }}</strong><br/><br/>
      Thanks for signing up with Techmandu! Please verify your email address by clicking the button below to activate your account.
    </mj-text>
  </mj-section>

  <mj-section padding-bottom="20px">
    <mj-column>
      <mj-button
        font-family="Helvetica"
        font-size="16px"
        background-color="#F15A27"
        color="white"
        border-radius="10px"
        width="100%"
        height="50px"
        padding="20px 0"
        href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}">
        Verify My Email
      </mj-button>
    </mj-column>
  </mj-section>

  <mj-section padding-bottom="20px">
    <mj-text font-size="20px" color="#000000" line-height="1.5" padding="0">
      If you didn’t create an account with us, please ignore this email.<br/><br/>
      <strong>Thank you,<br/>Techmandu Team</strong>
    </mj-text>
  </mj-section>

{{> footer }}

APP_ENV=dev
UI_ENV=dev
EMAIL_ENV=dev

PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure_master
DB_USERNAME=postgres
DB_PASSWORD=root
DB_SCHEMA=public

COOKIE_SECRET=secret-master
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin


SMTP_HOST= 
SMTP_USER= 
SMTP_PASS= 
SMTP_PORT=
SMTP_FROM_EMAIL=

VERIFY_EMAIL_URL=
PASSWORD_RESET_URL=
CHANGE_EMAIL_URL=


PUPPETEER_SKIP_DOWNLOAD=true # only if using system chromium; setup in plugins/invoices/services/invoice.service.ts as well

SERVER_URL='http://localhost:3000/'

AWS_REGION=
AWS_ENDPOINT=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


ELASTIC_URL=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# --- NCM (Nepal Can Move) webhook ---
# Secret that forms the webhook URL: POST <SERVER_URL>webhooks/ncm/<NCM_WEBHOOK_SECRET>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, the webhook endpoint is disabled (answers 404).
NCM_WEBHOOK_SECRET=
# Only accept calls whose User-Agent starts with "NCM-Webhook/". Set to false for local curl tests only.
NCM_WEBHOOK_REQUIRE_UA=true
